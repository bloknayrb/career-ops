# Personal data (user fills these)
cv.md
data/applications.md
data/pipeline.md
data/scan-history.tsv
reports/*.md
!reports/.gitkeep
output/*
!output/.gitkeep
batch/logs/*
!batch/logs/.gitkeep
batch/batch-state.tsv
batch/batch-input.tsv
batch/tracker-additions/**/*.tsv
!batch/tracker-additions/.gitkeep
jds/*
!jds/.gitkeep

# Writing samples (user's personal files — never committed)
writing-samples/*
!writing-samples/README.md

# User config and customization (never auto-updated)
config/profile.yml
portals.yml
modes/_profile.md
.update-dismissed
.update-lock

# Secrets (never commit — use .env.example as template)
.env

# Generated
.resolved-prompt-*
node_modules/
bun.lock

# OS
.DS_Store
*.mov
*.mp4

# Claude Code local
.claude/settings.local.json
.mcp.json
.claude/memory/
career-dashboard
package-lock.json

# Rendered/generated personal artifacts (never publish)
cv-*.html
cl-*.html
*-tmp.html
.career-ops-render-*.html

# All pipeline data is personal (only the directory structure is tracked)
data/*
!data/.gitkeep

# Personal working files
interview-prep/
modes/_custom.md
tmp/

# Sync and runtime artifacts
*.sync-conflict-*
.fuse_hidden*
.stfolder/
batch/batch-runner.pid
batch/.batch-state.lock/
batch/*.bak
