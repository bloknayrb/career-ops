# Personal data (user fills these)
cv.md
# Named client engagements; CI (.github/workflows/no-user-data.yml) fails any PR adding this
article-digest.md
voice-dna.md
# Personal red-line patterns; survives update-system.mjs because it is not on its SYSTEM_PATHS allowlist
redline-check.mjs
data/applications.md
data/pipeline.md
data/scan-history.tsv
reports/*.md
!reports/.gitkeep
output/*
!output/.gitkeep
batch/logs/*
!batch/logs/.gitkeep
batch/batch-state.tsv
batch/batch-input.tsv
batch/tracker-additions/**/*.tsv
!batch/tracker-additions/.gitkeep
jds/*
!jds/.gitkeep

# Writing samples (user's personal files — never committed)
writing-samples/*
!writing-samples/README.md

# User config and customization (never auto-updated)
config/profile.yml
portals.yml
modes/_profile.md
.update-dismissed
.update-lock

# Secrets (never commit — use .env.example as template)
.env

# Generated
.resolved-prompt-*
node_modules/
bun.lock

# OS
.DS_Store
*.mov
*.mp4

# Claude Code local
.claude/settings.local.json
.mcp.json
.claude/memory/
career-dashboard
package-lock.json

# Rendered/generated personal artifacts (never publish)
cv-*.html
cl-*.html
*-tmp.html
.career-ops-render-*.html

# All pipeline data is personal (only the directory structure is tracked)
data/*
!data/.gitkeep

# Personal working files
interview-prep/
modes/_custom.md
tmp/

# Sync and runtime artifacts
*.sync-conflict-*
.fuse_hidden*
.stfolder/
batch/batch-runner.pid
batch/.batch-state.lock/
batch/*.bak

# Fork-local voice backstop. MUST stay untracked: update-system.mjs apply only
# touches its allowlist and never sweeps unknown files, so "untracked + unlisted"
# is the entire preservation mechanism (same trick as redline-check.mjs). Tracking
# either of these also trips validate-system-paths-coverage.mjs as an orphan, and
# a tracked tests/ file gets pruned by the updater on the first apply.
bk-voice-lint.mjs
tests/bk-voice-lint.test.mjs
output/.voice-lint/
# Same reasoning: tests/ is on SYSTEM_PATHS and the updater prunes any TRACKED
# tests/ file absent from upstream, so this must stay untracked to survive.
tests/cover-letter-prose.test.mjs
